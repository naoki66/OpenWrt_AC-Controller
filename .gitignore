# build output (anchored: only the repository-root bin/ holds build artifacts)
/bin/
/dist/

# runtime state
data/
*.db
*.db-wal
*.db-shm

# local overrides
.env
.env.local

# 部署目录的本地产物（绝不入库）：离线构建出的二进制
/controller/deploy/ac

# scratch space for manual verification (not part of the build)
.tmp/

# 本地工作记忆：含本机路径与调试记录，不入库
.workbuddy/

# editor / OS
.DS_Store
.idea/
.vscode/
*.swp
