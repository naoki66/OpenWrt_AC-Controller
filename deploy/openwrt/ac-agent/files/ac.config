# /etc/config/ac — AC 控制器连接参数
#
# 由 /etc/init.d/ac-agent 读取。留空 ac_addr 时 agent 会先向
# 255.255.255.255:29820 广播 AP_DISCOVER 自动发现控制器。

config agent 'agent'
	# 1 = 启用 AC 纳管：启动 agent、设为开机自启，并在 WAN 防火墙上放行
	# TCP 8090 与 UDP 29820/29821，便于初始化时被上游或 LAN 侧的 AC 接管。
	# 0 = 停止 agent、取消开机自启并移除上述放行规则。缺省开启。
	option enabled '1'

	# 控制器地址，host:port。留空表示自动发现。
	option ac_addr ''

	# 与控制器 AC_SHARED_SECRET 一致，留空表示控制器不校验。
	option secret ''

	# 心跳/轮询间隔，单位秒，缺省 20。
	option interval '20'

	# 1 = 只渲染并暂存，不写 /etc/config、不 reload。首次接入建议先开。
	option dry_run '0'

	# AP 间协同的 UDP 端口（用于 11k 邻居/客户端信息交换，控制器离线也生效）。
	# 0 表示关闭。缺省 29821。
	option peer_port '29821'

	# AP 间状态播报间隔，缺省 30s。远小于心跳间隔没有意义，只会增加广播。
	option peer_interval '30s'

	# 1 = 允许 agent 在客户端信号已经很弱、且其它 AP 有同 SSID 时发 11v BTM
	# 建议。只建议、不强踢；若启用了 usteer/dawn，agent 会自动让位。缺省 0。
	option peer_steer '0'

	# 漫游引导优先级策略：
	#   ac_priority  AC 优先（缺省）。控制器在线时按其下发的 steering 指令执行
	#                （自动停掉 dawn/usteer 等其它守护）；连续失联后回退到
	#                steering_fallback 指定的自主引导；恢复后自动回到 AC 指令。
	#   ac_only      只听控制器的，失联时保持最后一次指令的状态，不回退。
	#   autonomous   agent 完全不碰引导守护，usteer/dawn 由本地自行管理。
	option steering_mode 'ac_priority'

	# 失联后自主引导使用的守护进程：none / usteer / dawn / nrsyncd。
	# 仅 steering_mode=ac_priority 时生效；none 表示失联后不启用自主引导。
	option steering_fallback 'none'
