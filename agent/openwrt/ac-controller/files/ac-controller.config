# /etc/config/ac-controller — AC 控制器（管理端）运行参数
#
# 由 /etc/init.d/ac-controller 读取。网页管理界面在 http://<本机>:8090。

config controller 'controller'
	# 1 = 开机自启并常驻；0 = 停止服务且不随开机启动。缺省开启。
	option enabled '1'

	# 网页与 API 监听地址。缺省只监听所有地址的 8090。
	# 若只想在管理口提供服务，改成例如 '10.10.30.1:8090'。
	option http_addr ':8090'

	# AP 自动发现（UDP 广播）监听地址。AP 通过 255.255.255.255:29820
	# 寻找控制器，因此这里应监听管理网段可达的地址。
	option discover_addr '0.0.0.0:29820'

	# 与 AP 侧 /etc/config/ac 中 secret 一致的共享密钥，至少 12 位。
	# 留空表示不校验（仅建议在完全可信的管理网内使用）。
	option shared_secret ''

	# 首次启动时创建的网页管理员账号；之后在网页里修改密码。
	# admin_password 留空则使用内置初始密码 123456，首次登录后务必修改。
	option admin_user 'admin'
	option admin_password ''

	# 控制器状态目录：ac.db、ac.id、签名私钥、模板、分组、采纳关系都在这里。
	# 只有一个库，没有运行时/临时分库。必须位于可持久化的文件系统：
	# 指向 /tmp 会在重启后生成新身份，所有 AP 已钉住的公钥失效，
	# 且纳管关系、模板全部丢失。
	option data_dir '/etc/ac-controller'

	# 运行档位：openwrt = 关闭遥测历史与固件仓库、限制配置包版本与事件条数；
	# full = 全功能（与 Docker 部署一致）。
	option profile 'openwrt'

	# 遥测采样间隔与保留期。openwrt 档位下历史不落库，这两个值只在
	# profile 改为 full 或显式开启遥测后生效。
	option sample_interval '120s'
	option sample_retention '24h'

	# 每台 AP 保留的签名配置包版本数（0 = 不限）；事件日志上限（0 = 不限）。
	option package_history '1'
	option events_max '500'

	# Go 运行时内存上限与 GC 目标。路由器上建议保留，防止峰值内存失控。
	option go_memlimit '64MiB'
	option go_gc '50'
