# /etc/config/ac — AC 控制器连接参数
#
# 由 /etc/init.d/ac-agent 读取。留空 ac_addr 时 agent 会先向
# 255.255.255.255:29820 广播 AP_DISCOVER 自动发现控制器。

config agent 'agent'
	# 1 = 启用 AC 纳管并允许开机自启；0 = 停止 agent。缺省开启。
	# 该开关不会开放 WAN 防火墙。
	option enabled '1'

	# 控制器地址，host:port。留空表示自动发现。
	option ac_addr ''

	# 仅在 AC 确认负责二层配置且本设备应停止本地 DHCP 时打开。
	option disable_dhcp '0'

	# 与 AC 网页「AP 管理」中的共享密钥一致，至少 12 字符。
	option secret ''

	# 心跳/轮询间隔，单位秒，缺省 20。
	option interval '20'

	# DFS/CAC 较慢时可加长（10s 到 15m）。
	option health_timeout '45s'

	# AP 间协同的 UDP 端口（用于 11k 邻居/客户端信息交换，控制器离线也生效）。
	# 0 表示关闭。缺省 29821。
	option peer_port '29821'

	# AP 间状态播报间隔，缺省 30s。远小于心跳间隔没有意义，只会增加广播。
	option peer_interval '30s'

	# AP 间协同使用的逻辑网络（UCI 网络名，不是设备名）。agent 用它解析
	# l3_device，在管理口上加入 IPv6 link-local 组播组；解析或 IPv6 失败时
	# 自动回退 IPv4 广播。缺省 lan。
	option peer_network 'lan'

	# 1 = 允许 agent 在客户端信号已经很弱、且其它 AP 有同 SSID 时发 11v BTM
	# 建议。只建议、不强踢；若启用了 usteer/dawn，agent 会自动让位。
	# 缺省 1：控制器失联后，AP 之间继续通过 29821 互通并自行建议漫游，
	# 不依赖 nrsyncd（它只分发 11k 邻居表），2 台以上 AP 同样有效。
	option peer_steer '1'
