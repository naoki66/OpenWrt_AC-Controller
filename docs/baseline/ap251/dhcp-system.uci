package dhcp

config dnsmasq
	option rebind_protection '0'
	option local '/lan/'
	option domain 'lan'
	option min_cache_ttl '3600'
	option use_stale_cache '3600'
	option cachesize '8000'
	option authoritative '1'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'
	option localservice '0'
	option ednspacket_max '1232'
	option nonwildcard '0'
	option dnsseccheckunsigned '0'
	option boguspriv '0'
	option logqueries '1'
	option logfacility '/tmp/dnsmasq.log'
	option dns_redirect '0'
	list server '10.0.10.1'
	option noresolv '1'

config dhcp 'lan'
	option interface 'lan'
	option ra_dns '0'
	option ignore '1'
	option dynamicdhcp '0'

config odhcpd 'odhcpd'
	option maindhcp '0'
	option leasefile '/tmp/odhcpd.leases'
	option leasetrigger '/usr/sbin/odhcpd-update'
	option loglevel '4'
	option piodir '/tmp/odhcpd-piodir'
	option hostsdir '/tmp/hosts'

config dhcp 'lan2'
	option interface 'lan2'
	option ignore '1'
	option dynamicdhcp '0'

config dhcp 'lan3'
	option interface 'lan3'
	option ignore '1'
	option dynamicdhcp '0'

config dhcp 'lan4'
	option interface 'lan4'
	option ignore '1'
	option dynamicdhcp '0'

config dhcp 'lan5'
	option interface 'lan5'
	option ignore '1'
	option dynamicdhcp '0'

config dhcp 'lan6'
	option interface 'lan6'
	option ignore '1'
	option dynamicdhcp '0'

###
package system

config system
	option hostname 'AP-A'
	option timezone 'CST-8'
	option zonename 'Asia/Shanghai'
	option ttylogin '0'
	option log_size '128'
	option urandom_seed '0'
	option compat_version '1.0'
	option description 'XR1710G'
	option log_proto 'udp'
	option conloglevel '8'

config timeserver 'ntp'
	list server '10.0.10.1'
	list server 'ntp.aliyun.com'

config led 'led_lan3_amber'
	option name 'lan3'
	option sysfs 'lan3:amber'
	option trigger 'netdev'
	option mode 'link_10 link_100'
	option dev 'lan3'

config led 'led_lan3_green'
	option name 'lan3'
	option sysfs 'lan3:green'
	option trigger 'netdev'
	option mode 'link_1000 tx rx'
	option dev 'lan3'

config led 'led_lan4_amber'
	option name 'lan4'
	option sysfs 'lan4:amber'
	option trigger 'netdev'
	option mode 'link_10 link_100'
	option dev 'lan4'

config led 'led_lan4_green'
	option name 'lan4'
	option sysfs 'lan4:green'
	option trigger 'netdev'
	option mode 'link_1000 tx rx'
	option dev 'lan4'

config imm_init
	option lang '1'
	option system_chn '1'
	option apk_mirror 'https://mirrors.vsean.net/openwrt'

