config wifi-iface 'wifinet0'
	option device 'radio0'
	option mode 'ap'
	option ssid 'SSID-A'
	option encryption 'psk2+ccmp'
	option key 'REDACTED-PSK'
	option ieee80211k '1'
	option bss_transition '1'
	option ieee80211v '1'
	option wnm_sleep_mode '1'
	option wnm_sleep_mode_no_keys '1'
	option proxy_arp '1'
	option network 'lan'

