package wireless

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'soc/1fc00000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
	option radio '0'
	option band '2g'
	option channel 'auto'
	option htmode 'HE20'
	option country 'US'
	option cell_density '0'
	option txpower '28'
	option disabled '0'
	option he_mu_beamformer '0'
	option he_su_beamformer '1'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'soc/1fc00000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
	option radio '1'
	option band '5g'
	option channel '36'
	option htmode 'EHT160'
	option country 'US'
	option cell_density '0'
	option he_su_beamformer '1'
	option he_mu_beamformer '1'
	option eht_su_beamformer '1'
	option eht_mu_beamformer '1'
