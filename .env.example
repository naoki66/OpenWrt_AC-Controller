# Copy to .env and set a long random value before `docker compose up`.
AC_SHARED_SECRET=change-me-to-a-long-random-string

# Optional Bearer token for automation calling the management REST API. The Web
# UI always requires a login account: first start seeds admin/123456, change it
# from the system page.
AC_ADMIN_TOKEN=change-me-to-another-long-random-string

# Optional site NTP sources handed to every AP. Comma or space separated. The
# default is the public list below, which works on any subnet; if the site has
# an internal NTP server (gateway/NAS), put it first. The controller page can
# override this at runtime, and each AP persists the last list, so time sync
# keeps working after the controller is lost.
AC_NTP_SERVERS=ntp.ntsc.ac.cn,ntp1.aliyun.com,ntp.tencent.com,cn.pool.ntp.org
